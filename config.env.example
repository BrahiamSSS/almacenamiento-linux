# almacenamiento-linux: configuración local.
# Copiar a /etc/almacenamiento.env y ajustar. NO pongas contraseñas aquí:
# este archivo es legible por todos los usuarios (lo leen scripts de usuario y de root).
# Formato: shell (bash). Sin espacios alrededor del "=".

# --- Discos ---------------------------------------------------------------
DATOS_DIR=/mnt/datos                  # disco de datos y backups (btrfs)
VM_DIR=/mnt/vm                        # disco de máquinas virtuales
MONTAJES_VIGILADOS="/ /mnt/vm /mnt/datos"   # disk-alert revisa estos puntos de montaje
ALERTA_UMBRAL=85                      # % de uso a partir del que disk-alert avisa
NOTIFY_UID=1000                       # usuario que recibe las notificaciones de escritorio

# --- Teléfonos (movil, iphone-vm) ------------------------------------------
MOVIL_DIR=$DATOS_DIR/dispositivos
MOVIL_AUTO_HORAS=24                   # al conectar, no pregunta ni respalda si el último backup es más reciente
VM_MONITOR=/tmp/mac-monitor.sock      # socket del monitor QEMU de la VM
IPHONE_HOSTBUS=1                      # bus/puerto USB del iPhone (lsusb -t)
IPHONE_HOSTPORT=4

# --- Nube: Nextcloud (nube-sync) -------------------------------------------
NUBE_URL=https://nube.ejemplo.com
NUBE_REMOTO=nube                      # nombre del remoto rclone (rclone config)
NUBE_DOCS_LOCAL=$HOME/Documents       # carpeta sincronizada en ambos sentidos
NUBE_DOCS_REMOTO=/Documentos
# Carpetas que solo se SUBEN (rclone copy, nunca borra): "origen:destino" separados por espacio.
NUBE_SUBIR="$DATOS_DIR/archivo:Archivo"
NUBE_CELULARES=Celulares              # destino de las vistas archivos/ de cada teléfono ("" = no subir)

# --- Nube: backup cifrado (restic-nube) ------------------------------------
SERVIDOR_SSH=usuario@servidor.ejemplo.com
SERVIDOR_LLAVE=/home/usuario/.ssh/id_ed25519
SERVIDOR_KNOWN_HOSTS=/home/usuario/.ssh/known_hosts
RESTIC_RUTA=/srv/restic               # carpeta del repositorio en el servidor (fuera de Nextcloud)
RESTIC_RETENCION="--keep-daily 7 --keep-weekly 4 --keep-monthly 6"
BTRBK_DESTINO=$DATOS_DIR/btrbk        # de aquí restic toma el snapshot más reciente de @ y @home
